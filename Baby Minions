	play.Name = "PlayButton"
	play.Size = UDim2.fromOffset(76, 34)
	play.Position = UDim2.new(1, -92, 0.5, -17)
	play.BackgroundColor3 = Color3.fromRGB(70, 130, 90)
	play.Text = "PLAY"
	play.TextColor3 = Color3.fromRGB(255, 255, 255)
	play.TextSize = 11
	play.Font = Enum.Font.GothamBold
	play.AutoButtonColor = false
	play.Parent = card

	local playCorner = Instance.new("UICorner")
	playCorner.CornerRadius = UDim.new(0, 9)
	playCorner.Parent = play

	play.MouseEnter:Connect(function()
		tween(play, {
			BackgroundColor3 = Color3.fromRGB(82, 155, 108)
		})
	end)

	play.MouseLeave:Connect(function()
		tween(play, {
			BackgroundColor3 = Color3.fromRGB(70, 130, 90)
		})
	end)

	play.MouseButton1Click:Connect(function()
		local success, err = pcall(function()
			local fn = loadstring(scriptCode)

			if not fn then
				error("loadstring returned nil")
			end

			fn()
		end)

		if success then
			play.Text = "EXECUTED"
			play.BackgroundColor3 =
				Color3.fromRGB(60, 150, 80)

			task.delay(1.5, function()
				if play and play.Parent then
					play.Text = "PLAY"

					tween(play, {
						BackgroundColor3 =
							Color3.fromRGB(70, 130, 90)
					})
				end
			end)
		else
			play.Text = "ERROR"
			play.BackgroundColor3 =
				Color3.fromRGB(150, 60, 60)

			warn(
				"[Baby Minions Hub] Failed to execute "
					.. scriptName
					.. ": "
					.. tostring(err)
			)

			task.delay(1.5, function()
				if play and play.Parent then
					play.Text = "PLAY"

					tween(play, {
						BackgroundColor3 =
							Color3.fromRGB(70, 130, 90)
					})
				end
			end)
		end
	end)
end

