	{
		TextTransparency = 1
	}
):Play()

TweenService:Create(
	openingSubtitle,
	TweenInfo.new(0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
	{
		TextTransparency = 1
	}
):Play()

TweenService:Create(
	openingLine,
	TweenInfo.new(0.35),
	{
		Size = UDim2.fromOffset(0, 2)
	}
):Play()

TweenService:Create(
	loadingBackground,
	TweenInfo.new(0.35),
	{
		BackgroundTransparency = 1
	}
):Play()

TweenService:Create(
	loadingText,
	TweenInfo.new(0.35),
	{
		TextTransparency = 1
	}
):Play()

TweenService:Create(
	opening,
	TweenInfo.new(
		0.6,
		Enum.EasingStyle.Quint,
		Enum.EasingDirection.In
	),
	{
		BackgroundTransparency = 1
	}
):Play()

task.wait(0.35)

main.Visible = true
main.Size = UDim2.fromOffset(500, 320)
main.BackgroundTransparency = 1
main.Position = CENTER_POSITION
mainStroke.Transparency = 1

TweenService:Create(
	main,
	TweenInfo.new(
		0.65,
		Enum.EasingStyle.Back,
		Enum.EasingDirection.Out
	),
	{
		Size = NORMAL_SIZE,
		BackgroundTransparency = 0
	}
):Play()

TweenService:Create(
	mainStroke,
	TweenInfo.new(0.6),
	{
		Transparency = 0.25
	}
):Play()

task.wait(0.7)

if opening and opening.Parent then
	opening:Destroy()
end
