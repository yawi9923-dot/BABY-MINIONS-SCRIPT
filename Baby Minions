local function stopMiniDrag()
	if not draggingMini then
		return
	end

	draggingMini = false

	if miniDragConnection then
		miniDragConnection:Disconnect()
		miniDragConnection = nil
	end

	miniPosition = main.Position
end

local function startMiniDrag(input)
	if not minimized then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseButton1
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	draggingMini = true
	dragStart = input.Position
	dragStartPosition = main.Position

	if miniDragConnection then
		miniDragConnection:Disconnect()
	end

	miniDragConnection =
		UserInputService.InputChanged:Connect(function(
			changedInput
		)
			if not draggingMini then
				return
			end

			if changedInput.UserInputType
				~= Enum.UserInputType.MouseMovement
				and changedInput.UserInputType
				~= Enum.UserInputType.Touch then
				return
			end

			local delta =
				changedInput.Position - dragStart

			local newPosition = UDim2.new(
				dragStartPosition.X.Scale,
				dragStartPosition.X.Offset + delta.X,
				dragStartPosition.Y.Scale,
				dragStartPosition.Y.Offset + delta.Y
			)

			main.Position = newPosition
			miniPosition = newPosition
		end)
end

miniDragArea.InputBegan:Connect(startMiniDrag)

UserInputService.InputEnded:Connect(function(input)
	if not draggingMini then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		stopMiniDrag()
	end
end)

